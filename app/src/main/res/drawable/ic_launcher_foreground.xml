<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Diamond Precision Frame -->
    <path
        android:pathData="M54,22 L86,54 L54,86 L22,54 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#4000F2FE">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="22"
                android:startY="22"
                android:endX="86"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#2200F2FE" />
                <item android:offset="1.0" android:color="#1A7928CA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Signage Banner / Print Roll Cylinder Top -->
    <path
        android:pathData="M34,42 C34,38 74,38 74,42 C74,46 34,46 34,42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="42"
                android:endX="74"
                android:endY="42"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F2FE" />
                <item android:offset="1.0" android:color="#4FACFE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Printing Banner Roll Sheet Unfurling -->
    <path
        android:pathData="M34,42 L34,64 C34,68 74,68 74,64 L74,42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="42"
                android:endX="74"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#8000F2FE" />
                <item android:offset="0.5" android:color="#997928CA" />
                <item android:offset="1.0" android:color="#B300F2FE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Precision Cutting / Measure Guides -->
    <path
        android:pathData="M42,50 L66,50 M42,56 L60,56"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Center Laser / Spark of Precision -->
    <path
        android:pathData="M54,32 L56,36 L60,37 L57,40 L58,44 L54,42 L50,44 L51,40 L48,37 L52,36 Z"
        android:fillColor="#00F2FE" />

    <!-- Stylized Arabic B / P curve in glowing neon -->
    <path
        android:pathData="M46,70 C52,75 56,75 62,70"
        android:strokeWidth="3"
        android:strokeColor="#A855F7"
        android:strokeLineCap="round" />
</vector>
